default_platform(:ios)

platform :ios do

  desc "بناء التطبيق ورفعه إلى TestFlight"
  lane :beta do
    # سلسلة مفاتيح مؤقتة للتشغيل في CI — تُحذف تلقائيًا بعد انتهاء الوظيفة
    setup_ci

    # مصادقة عبر مفتاح App Store Connect API بدل Apple ID
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY"],
      in_house: false
    )

    # سحب الشهادة وملف التزويد من مستودع share-certs
    match(
      type: "appstore",
      api_key: api_key,
      readonly: false
    )

    # اسم ملف التزويد الفعلي كما ثبّته match — لا نثبّته يدويًا
    profile_name = ENV["sigh_sa.almubarky.shareApp_appstore_profile-name"]

    # ضبط التوقيع اليدوي في مشروع Xcode
    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: "5V6TC85KRL",
      targets: ["Runner"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "sa.almubarky.shareApp",
      profile_name: profile_name
    )

    # رقم بناء جديد في كل مرة — مأخوذ من رقم تشغيل GitHub Actions
    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"] || "1"
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "sa.almubarky.shareApp" => profile_name
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: "نسخة اختبارية من شارِك"
    )
  end
end
